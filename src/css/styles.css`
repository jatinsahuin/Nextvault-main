:root {
  /* Color Palette - Premium Dark */
  --bg-deep: #0a0a0a;
  --bg-surface: #121212;
  --bg-elevated: #1a1a1a;

  --text-primary: #e5e5e5;
  --text-secondary: #a0a0a0;
  --text-muted: #666666;

  --accent-primary: #ffffff;
  --accent-muted: #333333;

  --border-color: #222222;
  --border-highlight: #333333;

  --transition-smooth: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --font-main: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-deep);
  color: var(--text-primary);
  font-family: var(--font-main);
  height: 100vh;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}

/* Layout Structure */
.app-container {
  display: grid;
  grid-template-columns: 260px 1fr 320px;
  height: 100vh;
  width: 100vw;
}

/* Left Pane: Navigation */
.nav-pane {
  background-color: var(--bg-surface);
  border-right: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  padding: 2rem 1rem;
}

.nav-logo {
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-bottom: 3rem;
  padding-left: 0.5rem;
  color: var(--accent-primary);
}

.nav-group {
  margin-bottom: 2rem;
}

.nav-group-label {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  margin-bottom: 0.75rem;
  padding-left: 0.5rem;
}

.nav-item {
  display: flex;
  align-items: center;
  padding: 0.6rem 0.75rem;
  border-radius: 6px;
  cursor: pointer;
  color: var(--text-secondary);
  font-size: 0.9rem;
  transition: var(--transition-smooth);
  margin-bottom: 0.25rem;
  border: 1px solid transparent;
}

.nav-item:hover {
  background-color: var(--bg-elevated);
  color: var(--text-primary);
}

.nav-item.active {
  background-color: var(--bg-elevated);
  color: var(--accent-primary);
  border-color: var(--border-highlight);
}

/* Center Pane: Focus */
.focus-pane {
  background-color: var(--bg-deep);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow-y: auto;
}

.focus-header {
  padding: 2rem;
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
  width: 100%;
}

.focus-header h1 {
  font-size: 1.5rem;
  font-weight: 400;
  color: var(--text-primary);
  margin-bottom: 1rem;
}

.ask-container {
  max-width: 700px;
  margin: 0 auto 4rem auto;
  width: 90%;
  position: sticky;
  bottom: 2rem;
}

.ask-input-wrapper {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 0.75rem 1rem;
  display: flex;
  align-items: center;
  transition: var(--transition-smooth);
  box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

.ask-input-wrapper:focus-within {
  border-color: var(--border-highlight);
  box-shadow: 0 0 0 1px var(--border-highlight);
}

.ask-input {
  background: transparent;
  border: none;
  color: var(--text-primary);
  font-family: var(--font-main);
  font-size: 1rem;
  width: 100%;
  outline: none;
  padding: 0.25rem 0;
}

.ask-button {
  background: var(--accent-primary);
  color: var(--bg-deep);
  border: none;
  padding: 0.4rem 1rem;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: var(--transition-smooth);
}

.ask-button:hover {
  opacity: 0.9;
}

/* Synthesis View */
.synthesis-results {
  max-width: 800px;
  margin: 0 auto;
  width: 90%;
  padding-bottom: 10rem;
}

.result-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  line-height: 1.6;
  animation: fadeInUp 0.4s ease-out;
}

.result-answer {
  color: var(--text-primary);
  font-size: 1.05rem;
  margin-bottom: 1.5rem;
}

.result-sources {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.source-tag {
  font-size: 0.7rem;
  background-color: var(--bg-elevated);
  color: var(--text-secondary);
  padding: 0.2rem 0.5rem;
  border-radius: 4px;
  border: 1px solid var(--border-color);
  cursor: pointer;
  transition: var(--transition-smooth);
}

.source-tag:hover {
  color: var(--accent-primary);
  border-color: var(--border-highlight);
}

/* Right Pane: Context */
.context-pane {
  background-color: var(--bg-surface);
  border-left: 1px solid var(--border-color);
  padding: 2rem 1.5rem;
  overflow-y: auto;
}

.context-header {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  margin-bottom: 1.5rem;
}

.entity-detail {
  margin-bottom: 2rem;
}

.entity-name {
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--accent-primary);
  margin-bottom: 0.5rem;
}

.entity-type {
  font-size: 0.7rem;
  color: var(--text-muted);
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.entity-desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: var(--bg-deep);
}
::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--border-highlight);
}
